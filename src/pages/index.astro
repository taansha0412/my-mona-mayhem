---
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Compare GitHub contributions in a head-to-head battle." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
		<title>Mona Mayhem - GitHub Contribution Battle Arena</title>
	</head>
	<body>
		<main class="arena">
			<header class="intro">
				<button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false">
					Switch to Blue + Orange
				</button>
				<p class="eyebrow">GitHub Contribution Battle Arena</p>
				<h1>Mona Mayhem</h1>
				<p>Pick two players and see whose contributions come out on top.</p>
			</header>

			<form id="battle-form" class="battle-form" novalidate>
				<div class="players">
					<label class="player-input">
						<span>Player 1</span>
						<input
							id="player-one"
							name="playerOne"
							type="text"
							autocomplete="off"
							placeholder="GitHub username"
							required
							maxlength="39"
							aria-describedby="player-one-error"
						/>
						<span id="player-one-error" class="input-error" aria-live="polite" hidden></span>
					</label>
					<label class="player-input">
						<span>Player 2</span>
						<input
							id="player-two"
							name="playerTwo"
							type="text"
							autocomplete="off"
							placeholder="GitHub username"
							required
							maxlength="39"
							aria-describedby="player-two-error"
						/>
						<span id="player-two-error" class="input-error" aria-live="polite" hidden></span>
					</label>
				</div>
				<button id="battle-button" type="submit">Battle!</button>
			</form>

			<section id="results" class="results" aria-labelledby="results-title" hidden>
				<h2 id="results-title">Battle results</h2>
				<p id="battle-status" role="status" aria-live="polite"></p>
				<div id="player-results" class="player-results" hidden>
					<article class="result-card">
						<h3 id="player-one-name"></h3>
						<p><strong id="player-one-total"></strong> contributions</p>
						<p id="player-one-date-range" class="date-range"></p>
						<div id="player-one-graph" class="contribution-graph" role="img"></div>
					</article>
					<p class="vs-badge" aria-label="versus">VS</p>
					<article class="result-card">
						<h3 id="player-two-name"></h3>
						<p><strong id="player-two-total"></strong> contributions</p>
						<p id="player-two-date-range" class="date-range"></p>
						<div id="player-two-graph" class="contribution-graph" role="img"></div>
					</article>
				</div>
				<p id="battle-winner" class="winner" role="status" aria-live="polite" hidden></p>
			</section>
		</main>

		<style>
			:root {
				--accent-primary: #5fed83;
				--accent-primary-rgb: 95 237 131;
				--accent-secondary: #8a2be2;
				--accent-secondary-rgb: 138 43 226;
				font-family: system-ui, sans-serif;
				color: #e9e7f5;
				background: #0a0a1a;
				font-synthesis: none;
				color-scheme: dark;
			}

			:root[data-theme='blue-orange'] {
				--accent-primary: #00f5ff;
				--accent-primary-rgb: 0 245 255;
				--accent-secondary: #ff6b35;
				--accent-secondary-rgb: 255 107 53;
			}

			* {
				box-sizing: border-box;
			}

			body {
				position: relative;
				margin: 0;
				min-width: 320px;
				min-height: 100vh;
				background:
					radial-gradient(
						ellipse at 50% 0%,
						rgb(var(--accent-secondary-rgb) / 14%),
						transparent 55%
					),
					#0a0a1a;
			}

			body::before {
				position: fixed;
				z-index: 5;
				background: repeating-linear-gradient(
					to bottom,
					transparent 0,
					transparent 3px,
					rgb(0 0 0 / 30%) 4px,
					rgb(0 0 0 / 30%) 5px
				);
				content: '';
				inset: 0;
				pointer-events: none;
			}

			.arena {
				position: relative;
				z-index: 1;
				width: min(100% - 2rem, 44rem);
				margin: 0 auto;
				padding: 4rem 0;
			}

			.intro {
				margin-bottom: 2rem;
				text-align: center;
			}

			.eyebrow {
				margin: 0 0 0.75rem;
				color: var(--accent-primary);
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				text-shadow: 0 0 0.8rem rgb(var(--accent-primary-rgb) / 55%);
			}

			.theme-toggle {
				min-width: 0;
				margin: 0 0 1.5rem;
				padding: 0.55rem 0.75rem;
				border-color: var(--accent-secondary);
				background: transparent;
				color: var(--accent-primary);
				font-family: system-ui, sans-serif;
				font-size: 0.7rem;
				box-shadow: 0 0 0.8rem rgb(var(--accent-secondary-rgb) / 20%);
			}

			.theme-toggle:hover:not(:disabled) {
				box-shadow:
					0 0 0.75rem rgb(var(--accent-primary-rgb) / 45%),
					0 0 1.25rem rgb(var(--accent-secondary-rgb) / 35%);
			}

			h1,
			h2,
			h3,
			p {
				margin-top: 0;
			}

			h1 {
				margin-bottom: 0.5rem;
				font-size: clamp(2rem, 8vw, 3.25rem);
				font-family: 'Press Start 2P', system-ui, sans-serif;
				color: #f4fff7;
				text-shadow:
					0 0 0.2rem #fff,
					0 0 0.75rem var(--accent-primary),
					0 0 1.5rem rgb(var(--accent-primary-rgb) / 80%),
					0 0 2.5rem rgb(var(--accent-secondary-rgb) / 55%);
				animation: neon-pulse 2.8s ease-in-out infinite alternate;
			}

			.intro > p:last-child {
				margin-bottom: 0;
				color: #b9b5cc;
			}

			.battle-form,
			.results {
				padding: 1.5rem;
				border: 1px solid rgb(var(--accent-secondary-rgb) / 45%);
				border-radius: 1rem;
				background: linear-gradient(145deg, rgb(24 23 48 / 96%), rgb(14 14 32 / 98%));
				box-shadow:
					0 0.75rem 2rem rgb(0 0 0 / 35%),
					0 0 1.5rem rgb(var(--accent-secondary-rgb) / 12%);
			}

			.players {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
			}

			.player-results {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
				align-items: center;
				gap: 1rem;
				margin-top: 1rem;
			}

			.player-input {
				display: grid;
				gap: 0.5rem;
				color: var(--accent-primary);
				font-weight: 700;
				animation: float-in 700ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
			}

			.player-input:nth-child(2) {
				animation-delay: 130ms;
			}

			input {
				width: 100%;
				padding: 0.8rem 0.9rem;
				border: 1px solid rgb(var(--accent-secondary-rgb) / 65%);
				border-radius: 0.5rem;
				background: #0a0a1a;
				color: #f5f2ff;
				font: inherit;
				box-shadow: inset 0 0 0.8rem rgb(var(--accent-secondary-rgb) / 8%);
				transition:
					border-color 180ms ease,
					box-shadow 180ms ease;
			}

			input::placeholder {
				color: #817c9b;
			}

			.player-input.has-error {
				animation: error-shake 420ms ease-in-out;
			}

			input[aria-invalid='true'] {
				border-color: #ff3366;
				box-shadow:
					0 0 0 1px #ff3366,
					0 0 1rem rgb(255 51 102 / 45%);
			}

			.input-error {
				color: #ff3366;
				font-size: 0.8rem;
				font-weight: 600;
				text-shadow:
					0 0 0.35rem rgb(255 51 102 / 75%),
					0 0 0.8rem rgb(255 51 102 / 45%);
			}

			input:focus-visible,
			button:focus-visible {
				outline: 3px solid var(--accent-primary);
				outline-offset: 2px;
			}

			input:focus-visible {
				border-color: var(--accent-primary);
				box-shadow:
					0 0 0 1px var(--accent-primary),
					0 0 1rem rgb(var(--accent-primary-rgb) / 35%);
			}

			input[aria-invalid='true']:focus-visible {
				border-color: #ff3366;
				box-shadow:
					0 0 0 1px #ff3366,
					0 0 1rem rgb(255 51 102 / 45%);
			}

			button {
				display: block;
				min-width: 8rem;
				margin: 1.25rem auto 0;
				padding: 0.8rem 1.25rem;
				border: 1px solid var(--accent-primary);
				border-radius: 0.5rem;
				background: linear-gradient(120deg, var(--accent-primary), var(--accent-secondary));
				color: #0a0a1a;
				font-family: 'Press Start 2P', system-ui, sans-serif;
				font-size: 0.7rem;
				font-weight: 700;
				cursor: pointer;
				box-shadow: 0 0 1rem rgb(var(--accent-primary-rgb) / 25%);
				transition:
					box-shadow 180ms ease,
					transform 180ms ease;
			}

			button:hover:not(:disabled) {
				transform: translateY(-2px);
				box-shadow:
					0 0 0.75rem rgb(var(--accent-primary-rgb) / 65%),
					0 0 1.5rem rgb(var(--accent-secondary-rgb) / 50%);
			}

			button:disabled {
				cursor: wait;
				opacity: 0.7;
			}

			.results {
				margin-top: 1.5rem;
			}

			.results h2 {
				margin-bottom: 0.75rem;
				font-family: 'Press Start 2P', system-ui, sans-serif;
				font-size: 0.85rem;
				line-height: 1.7;
				color: var(--accent-primary);
			}

			#battle-status {
				margin-bottom: 0;
				color: #b9b5cc;
			}

			#battle-status.is-loading {
				color: var(--accent-primary);
				animation: loading-color-shift 1.2s ease-in-out infinite alternate;
			}

			#battle-status.is-error {
				color: #ff3366;
				text-shadow:
					0 0 0.35rem rgb(255 51 102 / 75%),
					0 0 0.8rem rgb(255 51 102 / 45%);
			}

			.result-card {
				position: relative;
				min-width: 0;
				overflow: hidden;
				padding: 1rem;
				border: 1px solid rgb(var(--accent-secondary-rgb) / 45%);
				border-radius: 0.75rem;
				background: linear-gradient(145deg, #181730, #101024);
				text-align: center;
				box-shadow: 0 0 1rem rgb(var(--accent-secondary-rgb) / 12%);
			}

			.result-card::after {
				position: absolute;
				top: 0;
				bottom: 0;
				left: -75%;
				width: 45%;
				background: linear-gradient(
					100deg,
					transparent,
					rgb(255 255 255 / 10%),
					rgb(var(--accent-primary-rgb) / 16%),
					transparent
				);
				content: '';
				pointer-events: none;
				transform: skewX(-18deg);
				animation: card-shimmer 5s ease-in-out infinite;
			}

			.result-card h3 {
				margin-bottom: 0.35rem;
				overflow-wrap: anywhere;
				color: var(--accent-primary);
				text-shadow: 0 0 0.65rem rgb(var(--accent-primary-rgb) / 38%);
			}

			.result-card p {
				margin-bottom: 0;
			}

			.date-range {
				margin-top: 0.4rem;
				color: #aaa5c2;
				font-size: 0.8rem;
			}

			.contribution-graph {
				display: grid;
				grid-auto-flow: column;
				grid-auto-columns: 0.65rem;
				grid-template-rows: repeat(7, 0.65rem);
				gap: 0.2rem;
				width: 100%;
				min-width: 0;
				margin-top: 1rem;
				overflow-x: auto;
				padding-bottom: 0.25rem;
			}

			.contribution-day {
				width: 0.65rem;
				height: 0.65rem;
				border-radius: 2px;
				background-color: var(--source-color);
				transition:
					box-shadow 140ms ease,
					transform 140ms ease;
			}

			:root[data-theme='blue-orange'] .contribution-day {
				background-color: color-mix(
					in srgb,
					var(--accent-primary) var(--contribution-intensity),
					#0a0a1a
				);
			}

			.contribution-day:hover {
				z-index: 1;
				transform: scale(1.35);
				box-shadow:
					0 0 0.35rem var(--accent-primary),
					0 0 0.8rem var(--accent-secondary);
			}

			.vs-badge {
				display: grid;
				width: 2.75rem;
				height: 2.75rem;
				margin: 0;
				place-items: center;
				border: 1px solid rgb(255 255 255 / 35%);
				border-radius: 50%;
				background: linear-gradient(
					135deg,
					var(--accent-primary),
					var(--accent-secondary),
					var(--accent-primary)
				);
				background-size: 250% 250%;
				color: #0a0a1a;
				font-family: 'Press Start 2P', system-ui, sans-serif;
				font-size: 0.55rem;
				font-weight: 800;
				text-shadow: 0 1px rgb(255 255 255 / 30%);
				box-shadow:
					0 0 0.85rem rgb(var(--accent-secondary-rgb) / 60%),
					0 0 1.4rem rgb(var(--accent-primary-rgb) / 28%);
				animation: vs-gradient-shift 3s ease-in-out infinite;
			}

			.result-card strong {
				color: var(--accent-primary);
				font-size: 1.2rem;
				text-shadow: 0 0 0.6rem rgb(var(--accent-primary-rgb) / 42%);
			}

			.winner {
				margin: 1.5rem 0 0;
				padding: 1rem;
				border: 1px solid var(--accent-primary);
				border-radius: 0.75rem;
				background: linear-gradient(
					110deg,
					rgb(var(--accent-primary-rgb) / 18%),
					rgb(var(--accent-secondary-rgb) / 30%)
				);
				color: var(--accent-primary);
				font-family: 'Press Start 2P', system-ui, sans-serif;
				font-size: clamp(0.7rem, 3vw, 1rem);
				font-weight: 700;
				line-height: 1.8;
				overflow-wrap: anywhere;
				text-align: center;
				text-shadow: 0 0 0.8rem rgb(var(--accent-primary-rgb) / 45%);
				box-shadow:
					0 0 1rem rgb(var(--accent-primary-rgb) / 25%),
					inset 0 0 1.5rem rgb(var(--accent-primary-rgb) / 8%);
				animation:
					winner-reveal 650ms cubic-bezier(0.2, 0.75, 0.25, 1) both,
					winner-glow 1.8s ease-in-out 650ms infinite alternate;
			}

			.winner.is-tie {
				border-color: var(--accent-secondary);
				background: linear-gradient(
					110deg,
					rgb(var(--accent-secondary-rgb) / 30%),
					rgb(var(--accent-primary-rgb) / 15%)
				);
				color: #e4c8ff;
				text-shadow: 0 0 0.8rem rgb(var(--accent-secondary-rgb) / 75%);
				box-shadow:
					0 0 1rem rgb(var(--accent-secondary-rgb) / 35%),
					inset 0 0 1.5rem rgb(var(--accent-secondary-rgb) / 10%);
			}

			@media (max-width: 1024px) {
				.player-results {
					grid-template-columns: minmax(0, 1fr);
					justify-items: center;
				}

				.result-card {
					width: 100%;
				}
			}

			@media (max-width: 768px) {
				.arena {
					padding: 2.5rem 0;
				}

				.intro {
					margin-bottom: 1.5rem;
				}

				.eyebrow {
					font-size: 0.7rem;
				}

				h1 {
					font-size: clamp(1.5rem, 8vw, 2.5rem);
				}

				.intro > p:last-child {
					font-size: 0.95rem;
				}

				.players {
					grid-template-columns: 1fr;
				}

				.battle-form,
				.results {
					padding: 1.15rem;
				}

				.results h2 {
					font-size: 0.75rem;
				}

				input {
					min-height: 2.75rem;
					font-size: 0.95rem;
				}

				button {
					width: 100%;
					min-height: 2.75rem;
					font-size: 0.6rem;
				}

				.date-range {
					font-size: 0.75rem;
				}
			}

			@keyframes error-shake {
				0%,
				100% {
					transform: translateX(0);
				}
				20%,
				60% {
					transform: translateX(-0.4rem);
				}
				40%,
				80% {
					transform: translateX(0.4rem);
				}
			}

			@keyframes neon-pulse {
				from {
					filter: brightness(0.85);
					text-shadow:
						0 0 0.15rem #fff,
						0 0 0.5rem var(--accent-primary),
						0 0 1rem rgb(var(--accent-primary-rgb) / 60%),
						0 0 1.75rem rgb(var(--accent-secondary-rgb) / 40%);
				}
				to {
					filter: brightness(1.15);
					text-shadow:
						0 0 0.25rem #fff,
						0 0 0.85rem var(--accent-primary),
						0 0 1.75rem rgb(var(--accent-primary-rgb) / 90%),
						0 0 3rem rgb(var(--accent-secondary-rgb) / 70%);
				}
			}

			@keyframes vs-gradient-shift {
				0%,
				100% {
					background-position: 0% 50%;
					transform: rotate(-8deg) scale(1);
				}
				50% {
					background-position: 100% 50%;
					transform: rotate(8deg) scale(1.08);
				}
			}

			@keyframes card-shimmer {
				0%,
				65%,
				100% {
					left: -75%;
				}
				35% {
					left: 130%;
				}
			}

			@keyframes float-in {
				from {
					opacity: 0;
					transform: translateY(0.75rem);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes loading-color-shift {
				from {
					color: var(--accent-primary);
					text-shadow: 0 0 0.35rem rgb(var(--accent-primary-rgb) / 45%);
				}
				to {
					color: var(--accent-secondary);
					text-shadow: 0 0 0.55rem rgb(var(--accent-secondary-rgb) / 70%);
				}
			}

			@keyframes winner-reveal {
				from {
					opacity: 0;
					transform: scale(0.85) translateY(0.75rem);
				}
				to {
					opacity: 1;
					transform: scale(1) translateY(0);
				}
			}

			@keyframes winner-glow {
				from {
					filter: brightness(0.9);
				}
				to {
					filter: brightness(1.25);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				*,
				*::before,
				*::after {
					scroll-behavior: auto !important;
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.01ms !important;
				}
			}
		</style>

		<script>
			interface ContributionDay {
				weekday: number;
				count: number;
				level: number;
			}

			interface ContributionWeek {
				first_day: string;
				contribution_days: ContributionDay[];
			}

			interface ContributionData {
				total_contributions: number;
				from: string;
				to: string;
				colors_full: string[];
				weeks: ContributionWeek[];
			}

			const form = document.querySelector<HTMLFormElement>('#battle-form');
			const playerOneInput = document.querySelector<HTMLInputElement>('#player-one');
			const playerTwoInput = document.querySelector<HTMLInputElement>('#player-two');
			const playerOneError = document.querySelector<HTMLElement>('#player-one-error');
			const playerTwoError = document.querySelector<HTMLElement>('#player-two-error');
			const battleButton = document.querySelector<HTMLButtonElement>('#battle-button');
			const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
			const results = document.querySelector<HTMLElement>('#results');
			const battleStatus = document.querySelector<HTMLElement>('#battle-status');
			const playerResults = document.querySelector<HTMLElement>('#player-results');
			const playerOneName = document.querySelector<HTMLElement>('#player-one-name');
			const playerTwoName = document.querySelector<HTMLElement>('#player-two-name');
			const playerOneTotal = document.querySelector<HTMLElement>('#player-one-total');
			const playerTwoTotal = document.querySelector<HTMLElement>('#player-two-total');
			const playerOneDateRange = document.querySelector<HTMLElement>('#player-one-date-range');
			const playerTwoDateRange = document.querySelector<HTMLElement>('#player-two-date-range');
			const playerOneGraph = document.querySelector<HTMLElement>('#player-one-graph');
			const playerTwoGraph = document.querySelector<HTMLElement>('#player-two-graph');
			const battleWinner = document.querySelector<HTMLElement>('#battle-winner');

			if (
				!form ||
				!playerOneInput ||
				!playerTwoInput ||
				!playerOneError ||
				!playerTwoError ||
				!battleButton ||
				!themeToggle ||
				!results ||
				!battleStatus ||
				!playerResults ||
				!playerOneName ||
				!playerTwoName ||
				!playerOneTotal ||
				!playerTwoTotal ||
				!playerOneDateRange ||
				!playerTwoDateRange ||
				!playerOneGraph ||
				!playerTwoGraph ||
				!battleWinner
			) {
				throw new Error('Battle page is missing a required element.');
			}

			themeToggle.addEventListener('click', () => {
				const useBlueOrange = document.documentElement.dataset.theme !== 'blue-orange';
				if (useBlueOrange) {
					document.documentElement.dataset.theme = 'blue-orange';
				} else {
					delete document.documentElement.dataset.theme;
				}

				themeToggle.setAttribute('aria-pressed', String(useBlueOrange));
				themeToggle.textContent = useBlueOrange
					? 'Switch to Green + Purple'
					: 'Switch to Blue + Orange';
			});

			function isRecord(value: unknown): value is Record<string, unknown> {
				return typeof value === 'object' && value !== null;
			}

			function isIsoDate(value: unknown): value is string {
				if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value)) {
					return false;
				}

				const date = new Date(`${value}T00:00:00Z`);
				return Number.isFinite(date.getTime()) && date.toISOString().slice(0, 10) === value;
			}

			function parseContributionData(data: unknown, username: string): ContributionData {
				if (
					!isRecord(data) ||
					typeof data.total_contributions !== 'number' ||
					!Number.isInteger(data.total_contributions) ||
					data.total_contributions < 0 ||
					!isIsoDate(data.from) ||
					!isIsoDate(data.to) ||
					!Array.isArray(data.colors_full) ||
					data.colors_full.length === 0 ||
					!data.colors_full.every(
						(color) => typeof color === 'string' && /^#[\da-f]{6}$/i.test(color),
					) ||
					!Array.isArray(data.weeks)
				) {
					throw new Error(`Contribution data for ${username} was not in the expected format.`);
				}

				const weeks: ContributionWeek[] = data.weeks.map((week) => {
					if (
						!isRecord(week) ||
						!isIsoDate(week.first_day) ||
						!Array.isArray(week.contribution_days) ||
						week.contribution_days.length !== 7
					) {
						throw new Error(`Contribution data for ${username} was not in the expected format.`);
					}

					const contributionDays: ContributionDay[] = week.contribution_days.map((day, index) => {
						if (
							!isRecord(day) ||
							day.weekday !== index ||
							typeof day.count !== 'number' ||
							!Number.isInteger(day.count) ||
							day.count < 0 ||
							typeof day.level !== 'number' ||
							!Number.isInteger(day.level) ||
							day.level < 0 ||
							day.level >= data.colors_full.length
						) {
							throw new Error(`Contribution data for ${username} was not in the expected format.`);
						}

						return {
							weekday: day.weekday,
							count: day.count,
							level: day.level,
						};
					});

					return { first_day: week.first_day, contribution_days: contributionDays };
				});

				return {
					total_contributions: data.total_contributions,
					from: data.from,
					to: data.to,
					colors_full: data.colors_full,
					weeks,
				};
			}

			function validateUsername(username: string): string | null {
				if (!username) {
					return 'Enter a GitHub username.';
				}

				if (
					username.length > 39 ||
					!/^[a-z\d](?:[a-z\d-]{0,37}[a-z\d])?$/i.test(username) ||
					username.includes('--')
				) {
					return 'Use 1–39 letters, numbers, or hyphens; start and end with a letter or number, and avoid consecutive hyphens.';
				}

				return null;
			}

			function setInputError(
				input: HTMLInputElement,
				errorElement: HTMLElement,
				message: string | null,
			): void {
				const playerInput = input.closest<HTMLElement>('.player-input');
				if (!playerInput) {
					throw new Error('Username input is missing its player label.');
				}

				if (message) {
					input.setAttribute('aria-invalid', 'true');
					playerInput.classList.add('has-error');
					errorElement.textContent = message;
					errorElement.hidden = false;
				} else {
					input.removeAttribute('aria-invalid');
					playerInput.classList.remove('has-error');
					errorElement.textContent = '';
					errorElement.hidden = true;
				}
			}

			async function fetchContributions(username: string): Promise<ContributionData> {
				const response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
				let data: unknown;
				try {
					data = await response.json();
				} catch {
					throw new Error(`Could not read contribution data for ${username}.`);
				}

				if (!response.ok) {
					const message =
						isRecord(data) &&
						isRecord(data.error) &&
						typeof data.error.message === 'string'
							? data.error.message
							: `Could not load contributions for ${username}.`;
					throw new Error(message);
				}

				return parseContributionData(data, username);
			}

			function formatDate(date: string): string {
				return new Intl.DateTimeFormat(undefined, {
					day: 'numeric',
					month: 'short',
					timeZone: 'UTC',
					year: 'numeric',
				}).format(new Date(`${date}T00:00:00Z`));
			}

			function renderGraph(graph: HTMLElement, data: ContributionData, username: string): void {
				graph.replaceChildren();
				graph.setAttribute(
					'aria-label',
					`${username} contributions from ${formatDate(data.from)} to ${formatDate(data.to)}`,
				);

				for (const week of data.weeks) {
					for (const day of week.contribution_days) {
						const date = new Date(`${week.first_day}T00:00:00Z`);
						date.setUTCDate(date.getUTCDate() + day.weekday);
						const dateLabel = date.toISOString().slice(0, 10);
						const square = document.createElement('span');
						square.className = 'contribution-day';
						square.style.setProperty('--source-color', data.colors_full[day.level]);
						square.style.setProperty(
							'--contribution-intensity',
							`${data.colors_full.length > 1 ? (day.level / (data.colors_full.length - 1)) * 100 : 0}%`,
						);
						square.title = `${dateLabel}: ${day.count} contributions`;
						square.setAttribute('aria-hidden', 'true');
						graph.append(square);
					}
				}
			}

			for (const [input, errorElement] of [
				[playerOneInput, playerOneError],
				[playerTwoInput, playerTwoError],
			]) {
				input.addEventListener('input', () => {
					if (input.getAttribute('aria-invalid') === 'true') {
						setInputError(input, errorElement, validateUsername(input.value.trim()));
					}
				});
			}

			form.addEventListener('submit', async (event) => {
				event.preventDefault();

				const firstUsername = playerOneInput.value.trim();
				const secondUsername = playerTwoInput.value.trim();
				const firstError = validateUsername(firstUsername);
				const secondError = validateUsername(secondUsername);
				setInputError(playerOneInput, playerOneError, firstError);
				setInputError(playerTwoInput, playerTwoError, secondError);

				if (firstError || secondError) {
					(firstError ? playerOneInput : playerTwoInput).focus();
					return;
				}

				battleButton.disabled = true;
				battleButton.textContent = 'Battling...';
				form.setAttribute('aria-busy', 'true');
				results.hidden = false;
				playerResults.hidden = true;
				battleWinner.hidden = true;
				battleStatus.classList.remove('is-error');
				battleStatus.classList.add('is-loading');
				battleStatus.textContent = 'Loading contribution data...';

				try {
					const [firstData, secondData] = await Promise.all([
						fetchContributions(firstUsername),
						fetchContributions(secondUsername),
					]);

					playerOneName.textContent = firstUsername;
					playerTwoName.textContent = secondUsername;
					playerOneTotal.textContent = firstData.total_contributions.toLocaleString();
					playerTwoTotal.textContent = secondData.total_contributions.toLocaleString();
					playerOneDateRange.textContent = `${formatDate(firstData.from)} – ${formatDate(firstData.to)}`;
					playerTwoDateRange.textContent = `${formatDate(secondData.from)} – ${formatDate(secondData.to)}`;
					renderGraph(playerOneGraph, firstData, firstUsername);
					renderGraph(playerTwoGraph, secondData, secondUsername);
					battleStatus.textContent = 'The results are in!';
					playerResults.hidden = false;
					const isTie = firstData.total_contributions === secondData.total_contributions;
					battleWinner.classList.toggle('is-tie', isTie);
					battleWinner.textContent = isTie
						? "🤝 IT'S A TIE! 🤝"
						: `🏆 ${firstData.total_contributions > secondData.total_contributions ? firstUsername : secondUsername} WINS! 🏆`;
					battleWinner.hidden = false;
				} catch (error) {
					playerResults.hidden = true;
					battleStatus.classList.add('is-error');
					battleStatus.textContent =
						error instanceof Error ? error.message : 'Could not load contribution data. Please try again.';
				} finally {
					battleButton.disabled = false;
					battleButton.textContent = 'Battle!';
					form.removeAttribute('aria-busy');
					battleStatus.classList.remove('is-loading');
				}
			});
		</script>
	</body>
</html>
